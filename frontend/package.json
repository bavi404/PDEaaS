{
  "name": "pdeflow-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "PDEFlow web interface: FNO surrogate for 2D Darcy flow (Next.js + TypeScript + Plotly)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/third-party-licenses.mjs && next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "plotly.js-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
